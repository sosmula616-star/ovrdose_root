# ==============================================================================
# КОНФИГУРАЦИЯ ПРОЕКТА ROOT-CORE (Discord-бот Root + Web Admin Panel)
# ==============================================================================

# Токен и идентификаторы бота Root в Discord
DISCORD_TOKEN_ROOT=ваш_токен_бота_root
DISCORD_CLIENT_ID_ROOT=client_id_бота_root
DISCORD_CLIENT_SECRET=client_secret_для_oauth2

# Список ID владельцев (через запятую) с абсолютным доступом
OWNER_IDS=1558608015148716062

# ID серверов Discord
STAFF_GUILD_ID=1558608015148716062
MAIN_GUILD_ID=1558606862277017690

# Настройки веб-панели управления
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
PANEL_BASE_URL=http://127.0.0.1:3000
SESSION_SECRET=случайная_строка_минимум_32_символа_для_подписи_сессий

# Внутренний токен для взаимодействия с внешними ботами (Guard и др. через packages/bot-client)
INTERNAL_API_TOKEN=секретный_внутренний_токен_для_межпроцессного_обмена

# База данных SQLite (better-sqlite3 в WAL-режиме)
DB_PATH=./data/shared.db
