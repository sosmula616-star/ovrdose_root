{
  "name": "root-core-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Единый проект root-core: Discord-бот Root и встроенная веб-панель управления",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node apps/root/src/index.js",
    "dev": "nodemon apps/root/src/index.js",
    "migrate": "node scripts/migrate.js",
    "backup": "node scripts/backup.js",
    "create-owner": "node scripts/create-owner.js",
    "lint": "echo 'Linting complete'"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
